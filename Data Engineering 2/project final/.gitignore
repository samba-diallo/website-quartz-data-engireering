# Ignore data folders (raw files, streaming landing)
data/
outputs/
*.parquet
# JSON: only exclude data/output JSON, NOT frontend config (package.json, tsconfig.json, etc.)
data/**/*.json
outputs/**/*.json
*.json.gz

# Spark/Hadoop logs
spark-warehouse/
metastore_db/
derby.log
*.crc
.ipynb_checkpoints/
__pycache__/

# Mac/Windows system files
.DS_Store
Thumbs.db

# Exception : bundle de données Gold embarqué pour le déploiement du backend
# sur Render (free tier sans volume persistant). ~5 Mo, vraies données.
!backend/data/
!backend/data/**
