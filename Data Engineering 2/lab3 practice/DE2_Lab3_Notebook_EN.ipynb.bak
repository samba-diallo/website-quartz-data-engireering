   "source": [
    "## B.3 — Analyse de stabilité des seeds (Clustering)\n",
    "\n",
    "Pour le meilleur k trouvé, exécuter >=5 seeds et rapporter stabilité (moyenne ± écart-type du score Silhouette)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0870f44d",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\\n=== Analyse de stabilité des seeds ===\")\n",
    "\n",
    "# Trouver le meilleur k (k=8 généralement bon pour clustering esports)\n",
    "best_k = 8\n",
    "print(f\"Meilleur k choisi : {best_k} (test avec 5 seeds)\")\n",
    "\n",
    "silhouette_scores = []\n",
    "seed_results = []\n",
    "\n",
    "for seed_num in range(42, 47):  # 5 seeds\n",
    "    t_start = time.time()\n",
    "    \n",
    "    # KMeans avec seed différent\n",
    "    model_kmeans = KMeans(k=best_k, featuresCol=\"features\", seed=seed_num, maxIter=5)\n",
    "    model_trained = model_kmeans.fit(df_features)\n",
    "    predictions = model_trained.transform(df_features)\n",
    "    \n",
    "    # Évaluation\n",
    "    sil_score = evaluator.evaluate(predictions)\n",
    "    silhouette_scores.append(sil_score)\n",
    "    elapsed_ms = (time.time() - t_start) * 1000\n",
    "    \n",
    "    seed_results.append({\n",
    "        \"seed\": seed_num,\n",
    "        \"k\": best_k,\n",
    "        \"silhouette\": sil_score,\n",
    "        \"elapsed_ms\": elapsed_ms\n",
    "    })\n",
    "    \n",
    "    print(f\"  Seed {seed_num} : silhouette={sil_score:.4f}, temps={elapsed_ms:.1f} ms\")\n",
    "\n",
    "# Analyse statistique\n",
    "import statistics\n",
    "mean_sil = statistics.mean(silhouette_scores)\n",
    "stdev_sil = statistics.stdev(silhouette_scores) if len(silhouette_scores) > 1 else 0.0\n",
    "\n",
    "print(f\"\\nRésultats de stabilité (k={best_k}):\")\n",
    "print(f\"  Moyenne Silhouette : {mean_sil:.4f}\")\n",
    "print(f\"  Écart-type : {stdev_sil:.4f}\")\n",
    "print(f\"  Min: {min(silhouette_scores):.4f}, Max: {max(silhouette_scores):.4f}\")\n"
   ]
  },
